{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "LoyalSum Commerce API",
    "version": "1.0.0-draft",
    "summary": "Grænsefladen mellem commerce-adaptere (WooCommerce, Shopify, …) og LoyalSum core.",
    "description": "KONTRAKT, IKKE IMPLEMENTERING. Endpoints her findes ikke i LoyalSum core endnu. Ingen adapter må tale med LoyalSum på nogen anden måde end denne API over HTTPS. Ordrer sendes som deres NUVÆRENDE, normaliserede tilstand (CommerceOrder v1): order_status beskriver livsforløbet, payment_status økonomien og er autoritativ for optjening; beløb er heltal i mindste enhed med eksplicit _ex_tax/_incl_tax; refunderinger står kun i refunds[]. Se docs/commerce-api-contract.md for semantikken (inkl. eligible spend) og docs/security.md for signering."
  },
  "servers": [
    {
      "url": "https://loyalsum.dk/api/v1/commerce",
      "description": "Produktion (findes ikke endnu)"
    },
    {
      "url": "http://localhost:3000/api/v1/commerce",
      "description": "Lokal LoyalSum"
    }
  ],
  "security": [
    {
      "loyalsumHmac": []
    }
  ],
  "paths": {
    "/integrations/pair": {
      "post": {
        "operationId": "pairIntegration",
        "summary": "Par en butik med en LoyalSum-virksomhed med en engangskode fra LoyalSum-dashboardet.",
        "description": "Det eneste kald uden HMAC-signatur: der findes ingen nøgle endnu. Parringskoden er kortlivet, bruges én gang og er bundet til én virksomhed. Svaret bærer integrationens hemmelighed ÉN gang.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pairing_code",
                  "store"
                ],
                "properties": {
                  "pairing_code": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64
                  },
                  "store": {
                    "$ref": "./schemas/commerce-store.schema.json"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Parret.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "integration_id",
                    "signing_secret",
                    "contract_versions"
                  ],
                  "properties": {
                    "integration_id": {
                      "type": "string"
                    },
                    "signing_secret": {
                      "type": "string",
                      "description": "Vises én gang. Gemmes server-side i butikken, aldrig i browseren."
                    },
                    "contract_versions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/integrations/health": {
      "get": {
        "operationId": "integrationHealth",
        "summary": "Er forbindelsen i orden, og hvilke kontraktversioner forstår serveren?",
        "parameters": [
          {
            "$ref": "#/components/parameters/Integration"
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Signature"
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "integration_id",
                    "contract_versions",
                    "server_time"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "paused",
                        "revoked"
                      ]
                    },
                    "integration_id": {
                      "type": "string"
                    },
                    "contract_versions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "server_time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/orders/sync": {
      "post": {
        "operationId": "syncOrder",
        "summary": "Send en ordres NUVÆRENDE tilstand. LoyalSum regner delta.",
        "description": "Idempotent: samme ordretilstand sendt to gange giver 'unchanged'. Adapteren sender aldrig et 'giv N point' og aldrig et færdigregnet optjeningsbeløb — LoyalSum afleder eligible spend af ordren (varer efter rabat inkl. moms − refunderede varer), og kun payment_status paid/partially_refunded kvalificerer.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Integration"
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Signature"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "order",
                  "observed_at"
                ],
                "properties": {
                  "order": {
                    "$ref": "./schemas/commerce-order.schema.json"
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Hvornår adapteren læste ordren. En ÆLDRE tilstand end den seneste kendte ignoreres."
                  }
                }
              },
