    "/customers/link": {
      "post": {
        "operationId": "linkCustomer",
        "summary": "Bed LoyalSum koble en webshopkunde til en LoyalSum-kunde.",
        "description": "POST og ikke GET: e-mailen må aldrig stå i en URL, hvor den ender i logs. LoyalSum afgør, hvordan koblingen bekræftes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Integration"
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Signature"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/commerce-customer.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Koblet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/commerce-customer-link.schema.json"
                }
              }
            }
          },
          "202": {
            "description": "Bekræftelse afventer kunden."
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/customer/loyalty": {
      "get": {
        "operationId": "customerLoyalty",
        "summary": "Kundens saldo og status hos butikkens LoyalSum-virksomhed.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Integration"
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "name": "loyalsum_customer_ref",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Aldrig e-mail i URL'en."
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "loyalsum_customer_ref",
                    "points",
                    "stamp_cards"
                  ],
                  "properties": {
                    "loyalsum_customer_ref": {
                      "type": "string"
                    },
                    "points": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stamp_cards": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "program_id",
                          "stamps",
                          "stamps_required"
                        ],
                        "properties": {
                          "program_id": {
                            "type": "string"
                          },
                          "stamps": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "stamps_required": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rewards": {
      "get": {
        "operationId": "listRewards",
        "summary": "Belønninger, kunden kan bruge i denne butik.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Integration"
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "name": "loyalsum_customer_ref",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "rewards"
                  ],
                  "properties": {
                    "rewards": {
                      "type": "array",
                      "items": {
                        "$ref": "./schemas/commerce-reward.schema.json"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rewards/reserve": {
      "post": {
        "operationId": "reserveReward",
        "summary": "Hold en belønning af til én kurv. Saldoen trækkes først ved commit.",
        "description": "FEJLER LUKKET: kan LoyalSum ikke nås, eller svarer den ikke 201, gives der INGEN rabat. En almindelig checkout uden belønning må derimod aldrig blokeres.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Integration"
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Signature"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reward_id",
                  "loyalsum_customer_ref",
                  "external_cart_ref",
                  "cart_items_total_incl_tax"
                ],
                "properties": {
                  "reward_id": {
                    "type": "string"
                  },
                  "loyalsum_customer_ref": {
                    "type": "string"
                  },
                  "external_cart_ref": {
                    "type": "string"
                  },
                  "cart_items_total_incl_tax": {
                    "$ref": "./schemas/commerce-money.schema.json",
                    "description": "Kurvens varer EFTER øvrige rabatter, INKL. moms — samme grundlag som eligible spend. Fragt og gebyrer tæller ikke."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reserveret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/commerce-reward-reservation.schema.json"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rewards/release": {
      "post": {
        "operationId": "releaseReward",
        "summary": "Frigiv en reservation (kurven forladt, betaling fejlet). Idempotent.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Integration"
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Signature"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reservation_id"
                ],
                "properties": {
                  "reservation_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Frigivet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/commerce-reward-reservation.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/rewards/commit": {
      "post": {
        "operationId": "commitReward",
        "summary": "Ordren er betalt: træk saldoen og bind reservationen til ordren. Idempotent.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Integration"
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Signature"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reservation_id",
                  "external_order_id"
                ],
                "properties": {
                  "reservation_id": {
                    "type": "string"
                  },
                  "external_order_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/commerce-reward-reservation.schema.json"
                }
              }
            }
          },
          "410": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "loyalsumHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-LoyalSum-Signature",
        "description": "HMAC-SHA256 over en kanonisk streng. Kræver også X-LoyalSum-Integration, X-LoyalSum-Timestamp og X-LoyalSum-Request-Id. Se docs/security.md."
      }
    },
    "parameters": {
      "Integration": {
        "name": "X-LoyalSum-Integration",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Timestamp": {
        "name": "X-LoyalSum-Timestamp",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\d{10}$"
        },
        "description": "Unix-sekunder. Afvises, hvis mere end 300 s fra serverens ur."
      },
      "RequestId": {
        "name": "X-LoyalSum-Request-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
